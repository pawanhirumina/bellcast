# Copy to apps/web/.env.local for local development.

# Supabase (production). Leave empty to use the local file store in dev.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The one key that protects this instance. Generate with:
#   openssl rand -hex 32
BELLCAST_API_KEY=

# Optional
BELLCAST_RETENTION_DAYS=30
BELLCAST_MAX_BODY_BYTES=65536
CRON_SECRET=

# Set to 0 to disable the dev file store when Supabase is not configured.
BELLCAST_DEV_STORE=1
