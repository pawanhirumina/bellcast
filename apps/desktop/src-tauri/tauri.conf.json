{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bellcast",
  "version": "0.1.0",
  "identifier": "app.bellcast.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Self-hosted push notifications",
    "longDescription": "Bellcast is a self-hosted push notification client. It runs in the tray, keeps a long-poll connection to your instance open, and shows native notifications.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
